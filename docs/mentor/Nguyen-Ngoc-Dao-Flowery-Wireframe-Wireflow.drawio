        </mxCell>
        <mxCell id="delivered-v-3" value="&lt;b&gt;Liên kết nghiệp vụ&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;BPMN:&lt;/b&gt; O-T16/O-T18&lt;br&gt;&lt;b&gt;Role:&lt;/b&gt; Carrier service&lt;br&gt;&lt;b&gt;Điều kiện:&lt;/b&gt; Shipment = Shipping&lt;br&gt;&lt;b&gt;Chuyển trạng thái:&lt;/b&gt; Shipping → Delivered" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FB923C;strokeWidth=2;fontFamily=Arial;fontSize=13;fontColor=#7C2D12;align=left;verticalAlign=top;spacing=10;" vertex="1" parent="1">
