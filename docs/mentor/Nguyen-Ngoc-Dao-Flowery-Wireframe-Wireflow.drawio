        <mxCell id="delivered-v-1" value="Integration API – Giao hàng thành công" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=30;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
