PORT=5000
HOST=127.0.0.1
APP_SECRET=replace-with-a-long-random-secret
PARTNER_API_KEY=replace-with-a-partner-api-key
DB_CLIENT=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=flowery
MYSQL_USER=replace-with-database-user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_SSL=false
# Chỉ dùng đúng một lần khi database MySQL chưa có tài khoản nào.
BOOTSTRAP_ADMIN_EMAIL=replace-with-initial-admin-email
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
BOOTSTRAP_ADMIN_NAME=Quản trị Flowery
# Chỉ dùng khi chạy chế độ SQLite cục bộ/kiểm thử:
DATABASE_PATH=./server/data/flowery.db
CLIENT_ORIGIN=http://localhost:5173

